  "codeBlock": "SELECT s.sno, s.sname\nFROM Suppliers s, Catalogue c\nWHERE s.sno = c.sno AND\n      cost > (SELECT AVG (cost)\n              FROM Catalogue\n              WHERE pno = 'P4'\n              GROUP BY pno);",
